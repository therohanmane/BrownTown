# ---------------------------------------------------------------------------
# INBrownTown website — environment variables
# Copy to .env for local development. Set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL, used at BUILD time for canonical, og:url, JSON-LD and the
# sitemap. Leave empty until the production domain is confirmed and live.
# Example: https://www.example.com
VITE_SITE_URL=

# --- Enquiry delivery: option A — Resend (https://resend.com) --------------
# Server-only. The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# --- Enquiry delivery: option B — HTTPS webhook ----------------------------
# Used only when the Resend variables are not all set. Receives a JSON POST
# (e.g. a Google Apps Script, Zapier/Make hook, or your CRM).
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the X-Enquiry-Secret header.
ENQUIRY_WEBHOOK_SECRET=

# Optional comma-separated list of origins allowed to POST /api/enquiry.
# Example: https://www.example.com,https://example.vercel.app
ALLOWED_ORIGINS=

# --- Optional: video metadata sync (scripts/sync-youtube-meta.mjs) ----------
# YouTube Data API v3 key, used only by the local sync script, never shipped.
YOUTUBE_API_KEY=
